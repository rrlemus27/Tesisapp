<Window x:Class="StarAchiever.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star-Achiever · Iniciar sesión" Height="680" Width="1060"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource FuenteApp}" Foreground="{StaticResource NavyBrush}">

    <Window.Resources>
        <!-- Ojo de la contraseña: icono transparente, menta al pasar el mouse. -->
        <Style x:Key="BtnOjo" TargetType="Button" BasedOn="{StaticResource BtnIcono}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        </Style>

        <!-- Estrellas del panel de marca: titilan muy suave (un detalle, sin exagerar). -->
        <Style x:Key="EstrellaDecor" TargetType="ContentControl" BasedOn="{StaticResource Icono}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.25"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.55"
                                             Duration="0:0:2.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Sombra de la ventana (en un borde aparte, detrás del contenido) -->
        <Border CornerRadius="{StaticResource RadioGrande}" Background="White" Effect="{StaticResource SombraVentana}"/>

        <Border CornerRadius="{StaticResource RadioGrande}" Background="White"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Barra superior para mover/cerrar la ventana -->
                <Border Grid.ColumnSpan="2" VerticalAlignment="Top" Height="60"
                        Background="Transparent" MouseLeftButtonDown="Barra_Mover" Panel.ZIndex="10">
                    <Button Style="{StaticResource BtnVentana}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,16,0" Click="Cerrar_Click" ToolTip="Cerrar">
                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCerrar}" Width="16" Height="16"/>
                    </Button>
                </Border>

                <!-- ===== Panel de marca ===== -->
                <Border Grid.Column="0" CornerRadius="29,0,0,29" Background="{StaticResource FondoMarcaBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Brillo teal muy suave en la esquina inferior -->
                        <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-200,-220" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#5508AAA8" Offset="0"/>
                                    <GradientStop Color="#0008AAA8" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Estrellas decorativas -->
                        <Canvas IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource EstrellaDecor}" Tag="{StaticResource IcoChispa}"
                                            Canvas.Left="372" Canvas.Top="86" Width="20" Height="20"/>
                            <ContentControl Style="{StaticResource EstrellaDecor}" Tag="{StaticResource IcoEstrella}"
                                            Canvas.Left="410" Canvas.Top="300" Width="14" Height="14"/>
                            <ContentControl Style="{StaticResource EstrellaDecor}" Tag="{StaticResource IcoChispa}"
                                            Canvas.Left="300" Canvas.Top="540" Width="14" Height="14"/>
                            <ContentControl Tag="{StaticResource IcoEstrella}" Canvas.Left="420" Canvas.Top="520"
                                            Width="22" Height="22">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl" BasedOn="{StaticResource EstrellaDecor}">
                                        <Setter Property="Foreground" Value="{StaticResource AmarilloBrush}"/>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Canvas>

                        <Grid Margin="52,64,52,40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Logo (el mismo de la web) sobre una placa blanca -->
                            <Border Background="White" CornerRadius="18" Padding="16,12" HorizontalAlignment="Left">
                                <Image Source="{StaticResource Logo}" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="Panel de administración" FontSize="32" FontWeight="ExtraBold"
                                           Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="Gestiona usuarios, estudiantes, docentes y la estructura académica de la institución."
                                           FontSize="15" Foreground="#C8D3F0" TextWrapping="Wrap" LineHeight="22"
                                           MaxWidth="380" HorizontalAlignment="Left" Margin="0,12,0,26"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource BlancoTranslucidoBrush}">
                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoUsuarios}"
                                                        Foreground="White" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="Usuarios, estudiantes y docentes" Foreground="White" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource BlancoTranslucidoBrush}">
                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCapas}"
                                                        Foreground="White" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="Grados, secciones y períodos" Foreground="White" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource BlancoTranslucidoBrush}">
                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoLibro}"
                                                        Foreground="White" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="Materias y asignaciones" Foreground="White" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="2" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12"
                                    Padding="12,5" HorizontalAlignment="Left">
                                <TextBlock Text="Demostración · Tesis 2026" FontSize="12" FontWeight="Bold" Foreground="#C8D3F0"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== Formulario ===== -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="64,0">
                    <Border Background="{StaticResource MentaBrush}" CornerRadius="12" Padding="10,5,12,5"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoEstrella}" Width="14" Height="14"
                                            Foreground="{StaticResource TealOscuroBrush}"/>
                            <TextBlock Text="Bienvenido de nuevo" FontSize="12.5" FontWeight="ExtraBold" Margin="6,0,0,0"
                                       Foreground="{StaticResource TealOscuroBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Inicia sesión" FontSize="30" FontWeight="ExtraBold" Margin="0,14,0,0"/>
                    <TextBlock Text="Ingresa con tu usuario o correo y tu contraseña."
                               FontSize="14.5" Foreground="{StaticResource ApagadoBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,28"/>

                    <TextBlock Text="Usuario o correo" Style="{StaticResource Etiqueta}"/>
                    <Grid>
                        <TextBox x:Name="txtUsuario" MinHeight="50" FontSize="15" MaxLength="120" Padding="44,0,14,0"
                                 Tag="tucorreo@colegio.edu o tu usuario"/>
                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoUsuario}" Width="19" Height="19"
                                        Foreground="#2D4B86" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}" Margin="2,18,0,7"/>
                    <!-- La contraseña se escribe en el PasswordBox; el ojo la muestra en un TextBox
                         superpuesto (y la vuelve a ocultar). Solo uno de los dos está visible. -->
                    <Grid>
                        <PasswordBox x:Name="txtClave" MinHeight="50" FontSize="15" MaxLength="128"
                                     Padding="44,0,52,0"/>
                        <TextBox x:Name="txtClaveVisible" MinHeight="50" FontSize="15" MaxLength="128"
                                 Padding="44,0,52,0" FontWeight="Normal" IsUndoEnabled="False"
                                 Visibility="Collapsed"/>
                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCandado}" Width="19" Height="19"
                                        Foreground="#2D4B86" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                        <Button x:Name="btnVerClave" HorizontalAlignment="Right" Margin="0,0,8,0"
                                Style="{StaticResource BtnOjo}" Focusable="False"
                                Click="VerClave_Click" ToolTip="Mostrar contraseña">
                            <ContentControl x:Name="icoVerClave" Style="{StaticResource Icono}" Tag="{StaticResource IcoOjo}"
                                            Width="19" Height="19"/>
                        </Button>
                    </Grid>

                    <!-- Error del login (notificación discreta con icono) -->
                    <Border x:Name="brdError" Style="{StaticResource CajaEstado}" Margin="0,16,0,0"
                            Background="{StaticResource ErrorFondoBrush}" BorderBrush="{StaticResource ErrorBordeBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoError}" Width="18" Height="18"
                                            Foreground="{StaticResource ErrorTextoBrush}" VerticalAlignment="Top"
                                            Margin="0,0,10,0"/>
                            <TextBlock x:Name="lblError" Grid.Column="1" Style="{StaticResource TextoEstado}"
                                       Foreground="{StaticResource ErrorTextoBrush}"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnLogin" Content="Ingresar" Height="52" FontSize="15.5" Margin="0,24,0,0"
                            Style="{StaticResource BtnPrimario}" IsDefault="True" Click="Login_Click"/>

                    <!-- Estado real de la API (GET api/health al abrir la ventana). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Ellipse x:Name="dotApi" Width="8" Height="8" Fill="{StaticResource ApagadoBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblApi" Text="Comprobando la conexión con la API…" FontSize="12"
                                   Foreground="{StaticResource ApagadoBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="StarAchiever.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star-Achiever" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource FuenteApp}" Foreground="{StaticResource NavyBrush}">

    <Grid Margin="14">
        <!-- Sombra de la ventana (en un borde aparte, detrás del contenido) -->
        <Border CornerRadius="28" Background="{StaticResource FondoBrush}" Effect="{StaticResource SombraVentana}"/>

        <Border CornerRadius="28" Background="{StaticResource FondoBrush}"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== SIDEBAR ===================== -->
                <Border Grid.Column="0" CornerRadius="27,0,0,27" Background="White"
                        BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="22,26,22,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource AmarilloBrush}">
                                <TextBlock Text="★" FontSize="22" Foreground="{StaticResource AmarilloTextoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Star-Achiever" FontSize="18" FontWeight="ExtraBold"/>
                                <TextBlock Text="Plataforma educativa" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource ApagadoBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Usuario logueado -->
                        <Border Grid.Row="1" Background="{StaticResource MentaBrush}" CornerRadius="22"
                                Padding="14" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource TealBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="lblInicial" Text="?" FontSize="19" FontWeight="ExtraBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblNombre" Text="Usuario" FontSize="15" FontWeight="ExtraBold"
                                               TextWrapping="Wrap"/>
                                    <Border HorizontalAlignment="Left" Background="White" CornerRadius="10"
                                            Padding="9,2" Margin="0,5,0,0">
                                        <TextBlock x:Name="lblRolBadge" Text="ROL" FontSize="11" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource TealOscuroBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Menú -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="MENÚ" FontSize="11" FontWeight="ExtraBold"
                                       Foreground="{StaticResource ApagadoBrush}" Margin="8,0,0,10"/>
                            <Border Background="{StaticResource TealBrush}" CornerRadius="16" Padding="16,11" Margin="0,0,0,6">
                                <TextBlock x:Name="lblMenuItem" Text="◆   Inicio" FontSize="14" FontWeight="ExtraBold"
                                           Foreground="White"/>
                            </Border>
                            <Border CornerRadius="16" Padding="16,11" Margin="0,0,0,6">
                                <TextBlock Text="◇   Mi cuenta" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource ApagadoBrush}"/>
                            </Border>
                            <Border CornerRadius="16" Padding="16,11">
                                <TextBlock Text="◇   Configuración" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource ApagadoBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Decoración espacial -->
                        <Grid Grid.Row="3" Height="150" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="76" Height="76" Fill="{StaticResource MoradoBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="18" Height="12" Fill="White" Opacity="0.25"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-30,-28,0,0"/>
                            <Ellipse Width="138" Height="32" Stroke="{StaticResource AmarilloBrush}" StrokeThickness="5"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-14"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Text="✦" FontSize="16" Foreground="{StaticResource TealBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,4,0,0"/>
                            <TextBlock Text="★" FontSize="14" Foreground="{StaticResource AmarilloBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"/>
                            <TextBlock Text="✦" FontSize="12" Foreground="{StaticResource CoralBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,10"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource TealBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="38,0,0,22"/>
                        </Grid>

                        <Button Grid.Row="4" Content="⏻   Cerrar sesión" Height="46" FontSize="14" Margin="0"
                                Style="{StaticResource BtnAccion}"
                                Background="{StaticResource CoralSuaveBrush}" Foreground="{StaticResource CoralBrush}"
                                BorderBrush="{StaticResource CoralBrush}" Click="CerrarSesion_Click"/>
                    </Grid>
                </Border>

                <!-- ===================== CONTENIDO ===================== -->
                <Grid Grid.Column="1" Margin="30,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra superior (arrastrar la ventana / cerrar) -->
                    <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Barra_Mover" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                <TextBlock x:Name="lblTitulo" Text="Panel" FontSize="24" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="lblBienvenida" Text="Bienvenido" FontSize="14"
                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource BtnCerrar}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="Cerrar_Click" ToolTip="Cerrar"/>
                        </Grid>
                    </Border>

                    <!-- Tarjetas de resumen (ADMIN: conteos reales calculados de las listas de la API) -->
                    <UniformGrid x:Name="panelStats" Grid.Row="1" Rows="1" Margin="0,0,0,16"/>

                    <!-- ===== VISTA GENÉRICA (DOCENTE / ESTUDIANTE / otros roles) ===== -->
                    <Grid x:Name="panelGenerico" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna izquierda: lista de datos traídos de la API -->
                        <ContentControl Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="20,18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="lblSeccion" Text="Datos" Style="{StaticResource TituloTarjeta}"
                                           Margin="0,0,0,14"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="listaDatos" Margin="0,0,6,0"/>
                                </ScrollViewer>
                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                    <TextBlock x:Name="lblEstado" Style="{StaticResource TextoEstado}"/>
                                </Border>
                            </Grid>
                        </ContentControl>

                        <!-- Columna derecha: pestañas Temas / Preguntas / Actividades (solo DOCENTE) -->
                        <TabControl x:Name="tabsDocente" Grid.Column="1" Visibility="Collapsed"
                                    Width="480" Margin="20,0,0,0"
                                    Style="{StaticResource Tabs}" ItemContainerStyle="{StaticResource Tab}">

                            <!-- ===== Temas ===== -->
                            <TabItem Header="Temas">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,14,14,16">
                                            <TextBlock x:Name="lblTemasTitulo" Text="Temas" Style="{StaticResource TituloTarjeta}"
                                                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Nuevo tema" Style="{StaticResource Etiqueta}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtNuevoTema" Tag="Nombre del tema"/>
                                                <Button x:Name="btnCrearTema" Grid.Column="1" Content="＋  Crear tema"
                                                        Margin="10,0,0,0" Style="{StaticResource BtnPrimario}"
                                                        Click="CrearTema_Click"/>
                                            </Grid>

                                            <TextBlock Text="Temas de la materia (elige uno)" Style="{StaticResource Etiqueta}"
                                                       Margin="2,20,0,8"/>
                                            <ItemsControl x:Name="listaTemas"/>
                                            <Border Style="{StaticResource CajaEstado}">
                                                <TextBlock x:Name="lblTemasEstado" Style="{StaticResource TextoEstado}"/>
                                            </Border>

                                            <!-- Subtemas del tema (aparece al elegir un tema) -->
                                            <StackPanel x:Name="panelSubtemas" Visibility="Collapsed">
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock x:Name="lblTemaDetalleTitulo" Text="Tema"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16" Margin="0,0,0,12"/>
                                                <TextBlock Text="Subtemas" Style="{StaticResource Etiqueta}"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtNuevoSubtema" Tag="Nombre del subtema"/>
                                                    <Button x:Name="btnCrearSubtema" Grid.Column="1" Content="＋" MinWidth="50"
                                                            Padding="0" Margin="10,0,0,0" ToolTip="Crear subtema"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearSubtema_Click"/>
                                                </Grid>
                                                <ItemsControl x:Name="listaSubtemas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblSubtemasEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>

                            <!-- ===== Preguntas ===== -->
                            <TabItem Header="Preguntas">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,14,14,16">
                                            <TextBlock Text="Elige un tema en la pestaña «Temas» para crear y ver preguntas."
                                                       Style="{StaticResource AyudaTexto}" Margin="0,0,0,12"/>
                                            <StackPanel x:Name="panelPregunta" Visibility="Collapsed">
                                                <TextBlock x:Name="lblPreguntaTitulo" Text="Crear pregunta"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16" Margin="0,0,0,14"/>

                                                <TextBlock Text="Enunciado" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtEnunciado" Style="{StaticResource CampoMultilinea}"
                                                         Tag="Escribe la pregunta" Margin="0,0,0,12"/>

                                                <TextBlock Text="Explicación (opcional)" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtExplicacion" Style="{StaticResource CampoMultilinea}"
                                                         MinHeight="56" Margin="0,0,0,14"/>

                                                <TextBlock Text="Opciones (marca la correcta)" Style="{StaticResource Etiqueta}"
                                                           Margin="2,0,0,8"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp1" GroupName="OpcionCorrecta" IsChecked="True"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp1" Grid.Column="1" MinHeight="42" Tag="Opción 1"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp2" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp2" Grid.Column="1" MinHeight="42" Tag="Opción 2"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp3" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp3" Grid.Column="1" MinHeight="42" Tag="Opción 3"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp4" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp4" Grid.Column="1" MinHeight="42" Tag="Opción 4"/>
                                                </Grid>

                                                <Button x:Name="btnCrearPregunta" Content="＋  Crear pregunta"
                                                        Style="{StaticResource BtnPrimario}" Click="CrearPregunta_Click"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPreguntaEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>

                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock Text="Preguntas del tema" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                                <ItemsControl x:Name="listaPreguntas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPreguntasEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>

                            <!-- ===== Actividades ===== -->
                            <TabItem Header="Actividades">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="panelActividades" Visibility="Collapsed" Margin="16,14,14,16">
                                            <TextBlock Text="Crear, publicar y gestionar actividades."
                                                       Style="{StaticResource AyudaTexto}" Margin="0,0,0,12"/>

                                            <Border Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}"
                                                    BorderThickness="1.5" CornerRadius="20" Padding="16" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="Nueva actividad" Style="{StaticResource TituloTarjeta}" FontSize="16"/>
                                                    <TextBlock Text="Nace en borrador." Style="{StaticResource SubtituloTarjeta}"
                                                               Margin="0,2,0,14"/>

                                                    <TextBlock Text="Título" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtActTitulo" Tag="Título de la actividad" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Descripción (opcional)" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtActDescripcion" Style="{StaticResource CampoMultilinea}"
                                                             MinHeight="56" Margin="0,0,0,12"/>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActMateria" SelectionChanged="ActMateria_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <TextBlock Text="Tema" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActTema"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Modo de dificultad" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActModo" SelectedIndex="0">
                                                                <ComboBoxItem>MANUAL</ComboBoxItem>
                                                                <ComboBoxItem>ADAPTATIVA</ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <TextBlock Text="Tipo actividad (id)" Style="{StaticResource Etiqueta}"/>
                                                            <TextBox x:Name="txtActTipoId" Text="1"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Nivel inicial (id)" Style="{StaticResource Etiqueta}"/>
                                                            <TextBox x:Name="txtActNivelId" Text="1"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                                            <CheckBox x:Name="chkRecuperacion" Content="Recuperación activa"
                                                                      FontSize="13" Margin="0,0,0,8"/>
                                                            <CheckBox x:Name="chkRecompensas" Content="Recompensas activas"
                                                                      FontSize="13" IsChecked="True" Margin="0,0,0,4"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Button x:Name="btnCrearActividad" Content="＋  Crear actividad"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearActividad_Click"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Tus actividades" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                            <ItemsControl x:Name="listaActividades"/>
                                            <Border Style="{StaticResource CajaEstado}">
                                                <TextBlock x:Name="lblActividadesEstado" Style="{StaticResource TextoEstado}"/>
                                            </Border>

                                            <!-- Asignar preguntas del banco a la actividad elegida -->
                                            <StackPanel x:Name="panelAsignarPreguntas" Visibility="Collapsed">
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock x:Name="lblAsignarTitulo" Text="Asignar preguntas"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16"/>
                                                <TextBlock Text="Preguntas del tema de la actividad. Pulsa «Agregar» para añadirlas."
                                                           Style="{StaticResource SubtituloTarjeta}" Margin="0,3,0,12"/>
                                                <ItemsControl x:Name="listaBancoPreguntas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblAsignarEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>

                                                <!-- Estado y publicación de la actividad -->
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,16"/>
                                                <WrapPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Estado:" FontSize="13" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                                                    <Border x:Name="brdEstadoActual" CornerRadius="11"
                                                            Background="{StaticResource NeutroSuaveBrush}"
                                                            Padding="10,3" VerticalAlignment="Center" Margin="0,0,6,6">
                                                        <TextBlock x:Name="lblEstadoActual" Text="—" FontSize="11" FontWeight="ExtraBold"
                                                                   Foreground="{StaticResource ApagadoBrush}"/>
                                                    </Border>
                                                    <Button x:Name="btnEstadoPublicar" Content="Publicar actividad"
                                                            Style="{StaticResource BtnAccion}" Margin="0,0,6,6"
                                                            Background="{StaticResource VerdeSuaveBrush}"
                                                            Foreground="{StaticResource VerdeBrush}"
                                                            BorderBrush="{StaticResource VerdeBrush}"
                                                            Click="EstadoPublicar_Click"/>
                                                    <Button x:Name="btnEstadoCerrar" Content="Cerrar actividad"
                                                            Style="{StaticResource BtnAccion}" Margin="0,0,0,6"
                                                            Background="{StaticResource CoralSuaveBrush}"
                                                            Foreground="{StaticResource CoralBrush}"
                                                            BorderBrush="{StaticResource CoralBrush}"
                                                            Click="EstadoCerrar_Click"/>
                                                </WrapPanel>

                                                <Border Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}"
                                                        BorderThickness="1.5" CornerRadius="20" Padding="16" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="Publicar a una sección" Style="{StaticResource TituloTarjeta}"
                                                                   FontSize="16" Margin="0,0,0,14"/>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                                <ComboBox x:Name="cmbPubSeccion"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                                <ComboBox x:Name="cmbPubPeriodo"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Apertura" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubApertura" Tag="yyyy-MM-dd HH:mm"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Cierre" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubCierre" Tag="yyyy-MM-dd HH:mm"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Máx. intentos" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubIntentos" Text="1"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Duración (min)" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubDuracion" Tag="Opcional"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Button x:Name="btnPublicarSeccion" Content="＋  Publicar a la sección"
                                                                Style="{StaticResource BtnPrimario}" Click="PublicarSeccion_Click"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Publicada en" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                                <ItemsControl x:Name="listaPubSecciones"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPublicarEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <!-- ===== FIN VISTA GENÉRICA ===== -->

                    <!-- ===== VISTA ADMIN: pestañas por área ===== -->
                    <TabControl x:Name="panelAdmin" Grid.Row="2" Visibility="Collapsed"
                                Style="{StaticResource Tabs}" ItemContainerStyle="{StaticResource Tab}"
                                SelectionChanged="PanelAdmin_SelectionChanged">

                        <!-- ===== Materias ===== -->
                        <TabItem Header="Materias">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Nueva materia" Style="{StaticResource TituloTarjeta}"/>
                                            <TextBlock Text="Se crea activa; puedes desactivarla al editarla."
                                                       Style="{StaticResource SubtituloTarjeta}"/>
                                            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNuevaMateria" Tag="Ej.: Matemáticas" MaxLength="80"/>
                                            <Button x:Name="btnCrear" Content="＋  Crear materia" Margin="0,18,0,0"
                                                    Style="{StaticResource BtnPrimario}" Click="CrearMateria_Click"/>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="txtBuscarMateria" Tag="🔍  Buscar materia por nombre…"
                                             TextChanged="BuscarMateria_Changed" Margin="0,0,0,12"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="listaMaterias" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblMateriasEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Usuarios ===== -->
                        <TabItem Header="Usuarios">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Nuevo usuario" Style="{StaticResource TituloTarjeta}"
                                                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNombreCompleto" Tag="Ej.: Ana Pérez" Margin="0,0,0,10"
                                                     MaxLength="150"/>

                                            <TextBlock Text="Usuario o correo" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtCorreoUsuario" Tag="usuario o correo" Margin="0,0,0,10"
                                                     MaxLength="120"/>

                                            <TextBlock Text="Contraseña (8 a 128 caracteres)" Style="{StaticResource Etiqueta}"/>
                                            <PasswordBox x:Name="pwdClave" Margin="0,0,0,10" MaxLength="128"/>

                                            <!-- Los roles (id y código) se cargan de GET api/roles. -->
                                            <TextBlock Text="Rol" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbRol" Margin="0,0,0,16"/>

                                            <Button x:Name="btnCrearUsuario" Content="＋  Crear usuario"
                                                    Style="{StaticResource BtnPrimario}" Click="CrearUsuario_Click"/>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="txtBuscarUsuario" Tag="🔍  Buscar usuario por nombre…"
                                             TextChanged="BuscarUsuario_Changed" Margin="0,0,0,12"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="listaUsuarios" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblUsuariosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Estudiantes: baja / reactivación y sección (lista de api/Usuarios por rol) ===== -->
                        <TabItem Header="Estudiantes">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBuscarEstAdmin" Tag="🔍  Buscar estudiante por nombre o usuario…"
                                             TextChanged="BuscarEstAdmin_Changed"/>
                                    <ComboBox x:Name="cmbFiltroEstAdmin" Grid.Column="1" Margin="10,0,0,0"
                                              SelectedIndex="0" SelectionChanged="FiltroEstAdmin_Changed">
                                        <ComboBoxItem>Todos</ComboBoxItem>
                                        <ComboBoxItem>Activos</ComboBoxItem>
                                        <ComboBoxItem>De baja</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="listaEstAdmin" Margin="0,0,6,0"/>
                                </ScrollViewer>
                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                    <TextBlock x:Name="lblEstAdminEstado" Style="{StaticResource TextoEstado}"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== Docentes: baja / reactivación y sus clases ===== -->
                        <TabItem x:Name="tabDocentes" Header="Docentes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lista de docentes -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="txtBuscarDocente" Tag="🔍  Buscar docente por nombre o usuario…"
                                             TextChanged="BuscarDocente_Changed" Margin="0,0,0,12"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="listaDocentes" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblDocentesEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>

                                <!-- Clases del docente elegido (api/admin/asignaciones-docente) -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                                    <ContentControl Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,6,14">
                                        <StackPanel>
                                            <TextBlock Text="Clases del docente" Style="{StaticResource TituloTarjeta}"/>
                                            <TextBlock x:Name="lblClasesDocenteInfo"
                                                       Text="Elige un docente (botón «Clases») para ver y gestionar sus clases."
                                                       Style="{StaticResource SubtituloTarjeta}" Margin="0,3,0,0"/>

                                            <StackPanel x:Name="panelClasesDocente" Visibility="Collapsed" Margin="0,14,0,0">
                                                <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                <ComboBox x:Name="cmbClaseMateria" MinHeight="42" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbClaseSeccion" MinHeight="42"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                        <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbClasePeriodo" MinHeight="42"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Button x:Name="btnAgregarClase" Content="＋  Asignar clase"
                                                        Style="{StaticResource BtnPrimario}" Click="AgregarClase_Click"/>

                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,18,0,14"/>
                                                <ItemsControl x:Name="listaClasesDocente"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblClasesDocenteEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- ===== Grados y Secciones ===== -->
                        <TabItem Header="Grados y Secciones">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Grados -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Grados" Style="{StaticResource TituloTarjeta}"/>
                                            <TextBlock Text="Nombre y orden (0-255, opcional). «Secciones» abre las secciones de ese grado."
                                                       Style="{StaticResource SubtituloTarjeta}" Margin="0,3,0,14"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtNuevoGrado" Tag="Nombre del grado" MaxLength="50"/>
                                                <TextBox x:Name="txtOrdenGrado" Grid.Column="1" Text="1" Tag="Orden" MaxLength="3"
                                                         Margin="8,0,0,0" ToolTip="Orden (0-255). Déjalo vacío si no aplica."/>
                                                <Button x:Name="btnCrearGrado" Grid.Column="2" Content="＋ Crear"
                                                        Padding="18,0" Margin="8,0,0,0"
                                                        Style="{StaticResource BtnPrimario}" Click="CrearGrado_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </ContentControl>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="listaGrados" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblGradosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>

                                <!-- Secciones -->
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Secciones" Style="{StaticResource TituloTarjeta}"/>
                                            <TextBlock x:Name="lblSeccionesInfo"
                                                       Text="Elige un grado (botón «Secciones») para gestionar sus secciones."
                                                       Style="{StaticResource SubtituloTarjeta}" Margin="0,3,0,0"/>
                                            <!-- El formulario se muestra junto con panelSecciones (al elegir un grado). -->
                                            <StackPanel Visibility="{Binding Visibility, ElementName=panelSecciones}"
                                                        Margin="0,14,0,0">
                                                <TextBlock x:Name="lblSeccionesTitulo" Text="Nueva sección"
                                                           Style="{StaticResource Etiqueta}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtNuevaSeccion" Tag="Ej.: A" MaxLength="30"/>
                                                    <Button x:Name="btnCrearSeccion" Grid.Column="1" Content="＋ Crear"
                                                            Padding="18,0" Margin="8,0,0,0"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearSeccion_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </ContentControl>

                                    <!-- Estado vacío (queda detrás de la lista) -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource MentaBrush}">
                                            <TextBlock Text="★" FontSize="30" Foreground="{StaticResource TealBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Aquí verás las secciones del grado que elijas."
                                                   Style="{StaticResource AyudaTexto}" TextAlignment="Center"
                                                   MaxWidth="240" Margin="0,12,0,0"/>
                                    </StackPanel>

                                    <Grid x:Name="panelSecciones" Grid.Row="1" Visibility="Collapsed"
                                          Background="{StaticResource FondoBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="listaSecciones" Margin="0,0,6,0"/>
                                        </ScrollViewer>
                                        <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                            <TextBlock x:Name="lblSeccionesEstado" Style="{StaticResource TextoEstado}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Períodos ===== -->
                        <TabItem Header="Períodos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Nuevo período" Style="{StaticResource TituloTarjeta}"/>
                                            <TextBlock Text="Las fechas van en formato AAAA-MM-DD."
                                                       Style="{StaticResource SubtituloTarjeta}"/>

                                            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNombrePeriodo" Tag="Ej.: Año lectivo 2026" Margin="0,0,0,12"
                                                     MaxLength="50"/>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="Fecha inicio" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtFechaInicio" Tag="AAAA-MM-DD" MaxLength="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                    <TextBlock Text="Fecha fin" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtFechaFin" Tag="AAAA-MM-DD" MaxLength="10"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="chkActivoPeriodo" Content="Activo" IsChecked="True"
                                                      Margin="2,0,0,18"/>

                                            <Button x:Name="btnCrearPeriodo" Content="＋  Crear período"
                                                    Style="{StaticResource BtnPrimario}" Click="CrearPeriodo_Click"/>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Períodos académicos" Style="{StaticResource TituloTarjeta}"
                                               Margin="4,6,0,14"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="listaPeriodos" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblPeriodosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Asignaciones: docentes a materia + sección y estudiantes a sección ===== -->
                        <TabItem x:Name="tabAsignaciones">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Asignaciones" VerticalAlignment="Center"/>
                                    <!-- Aviso compacto: se muestra si la API no tiene los endpoints
                                         de asignaciones (404); el detalle va en el ToolTip. -->
                                    <Border x:Name="pillAsignaciones" Background="White" CornerRadius="9"
                                            BorderBrush="{StaticResource CoralBrush}" BorderThickness="1"
                                            Width="18" Height="18" Margin="7,0,0,0" VerticalAlignment="Center"
                                            ToolTip="No disponible en la API conectada">
                                        <TextBlock Text="!" FontSize="11" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource CoralBrush}"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <!-- Nota (solo se ve si AsignacionesDisponibles = false en el código) -->
                                <ScrollViewer x:Name="panelAsignacionesNota" VerticalScrollBarVisibility="Auto"
                                              Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource Tarjeta}" Padding="30,26" Margin="0,0,0,26"
                                                    MaxWidth="640" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left"
                                                    Background="{StaticResource AmarilloSuaveBrush}">
                                                <TextBlock Text="!" FontSize="26" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource AmarilloTextoBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Asignaciones desactivadas" Style="{StaticResource TituloTarjeta}"
                                                       FontSize="20" Margin="0,14,0,0"/>
                                            <TextBlock Style="{StaticResource AyudaTexto}" FontSize="14" Margin="0,8,0,0"
                                                       Text="Esta pestaña está desactivada en esta versión de la app, así que no hace ninguna llamada a la API desde aquí."/>
                                            <Border Background="{StaticResource MentaBrush}" CornerRadius="16" Padding="14,10"
                                                    Margin="0,18,0,0" HorizontalAlignment="Left">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TealOscuroBrush}"
                                                           Text="Las pestañas Materias, Usuarios, Grados y Secciones y Períodos funcionan con normalidad."/>
                                            </Border>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <!-- Formularios de asignación -->
                                <TabControl x:Name="panelAsignacionesForm"
                                            Style="{StaticResource TabsSub}" ItemContainerStyle="{StaticResource TabSub}">

                                    <!-- ===== Docente -> materia + sección (api/admin/asignaciones-docente) ===== -->
                                    <TabItem Header="Docentes → materia y sección">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="320"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,20,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Asignar docente a clase" Style="{StaticResource TituloTarjeta}"
                                                                   FontSize="16" Margin="0,0,0,12"/>

                                                        <TextBlock Text="Docente" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigDocente" MinHeight="42" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigMateria" MinHeight="42" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigSeccion" MinHeight="42" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigPeriodo" MinHeight="42" Margin="0,0,0,14"/>

                                                        <Button x:Name="btnCrearAsignacion" Content="＋  Asignar docente"
                                                                Style="{StaticResource BtnPrimario}" Click="CrearAsignacion_Click"/>
                                                    </StackPanel>
                                                </ContentControl>
                                            </ScrollViewer>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Docentes asignados" Style="{StaticResource TituloTarjeta}"
                                                           FontSize="16" Margin="4,4,0,12"/>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="listaAsignaciones" Margin="0,0,6,0"/>
                                                </ScrollViewer>
                                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblAsignacionesEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </TabItem>

                                    <!-- ===== Estudiante -> sección (api/admin/estudiantes-seccion) ===== -->
                                    <TabItem Header="Estudiantes → sección">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="320"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,20,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Asignar estudiante a sección" Style="{StaticResource TituloTarjeta}"
                                                                   FontSize="16"/>
                                                        <TextBlock Text="Si ya tiene sección, se cambia a la nueva."
                                                                   Style="{StaticResource SubtituloTarjeta}" Margin="0,2,0,12"/>

                                                        <TextBlock Text="Estudiante" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbEstEstudiante" MinHeight="42" Margin="0,0,0,8"/>

                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbEstSeccion" MinHeight="42" Margin="0,0,0,14"/>

                                                        <Button x:Name="btnAsignarEstudiante" Content="＋  Asignar a la sección"
                                                                Style="{StaticResource BtnPrimario}" Click="AsignarEstudiante_Click"/>
                                                        <TextBlock Text="Tip: «Asignar» o «Cambiar» en la lista deja elegido al estudiante aquí."
                                                                   Style="{StaticResource AyudaTexto}" Margin="2,12,0,0"/>
                                                    </StackPanel>
                                                </ContentControl>
                                            </ScrollViewer>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBox x:Name="txtBuscarEstudiante" Tag="🔍  Buscar estudiante por nombre…"
                                                         TextChanged="BuscarEstudiante_Changed" Margin="0,0,0,12"/>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="listaEstudiantesSeccion" Margin="0,0,6,0"/>
                                                </ScrollViewer>
                                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblEstudiantesEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <!-- ===== FIN VISTA ADMIN ===== -->
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

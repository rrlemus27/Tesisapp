<Window x:Class="StarAchiever.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Star-Achiever · Administración" Height="820" Width="1320" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource FondoBrush}"
        FontFamily="{StaticResource FuenteApp}" Foreground="{StaticResource NavyBrush}">

    <!-- Ventana sin marco del sistema pero redimensionable, con arrastre desde la barra superior. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="70" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="raiz" Background="{StaticResource FondoBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colSidebar" Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== MENÚ LATERAL ===================== -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,1,0">
                <Grid x:Name="sidebar" Margin="18,0,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo (el mismo de la web docente; se cambia en Assets/logo.png) -->
                    <Image x:Name="imgLogo" Source="{StaticResource Logo}" Height="40" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Margin="6,6,0,0" RenderOptions.BitmapScalingMode="HighQuality"
                           ToolTip="Star-Achiever"/>

                    <!-- Navegación: cada opción abre una sección del panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock x:Name="rotGeneral" Text="GENERAL" Style="{StaticResource Rotulo}" Margin="12,0,0,8"/>
                            <RadioButton x:Name="navInicio" GroupName="nav" Style="{StaticResource ItemMenu}"
                                         Tag="{StaticResource IcoInicio}" Content="Inicio" IsChecked="True"
                                         ToolTip="Inicio"/>

                            <StackPanel x:Name="menuAdmin">
                                <TextBlock x:Name="rotPersonas" Text="PERSONAS" Style="{StaticResource Rotulo}" Margin="12,14,0,8"/>
                                <RadioButton x:Name="navUsuarios" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoUsuarios}" Content="Usuarios" ToolTip="Usuarios"/>
                                <RadioButton x:Name="navEstudiantes" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoEstudiantes}" Content="Estudiantes" ToolTip="Estudiantes"/>
                                <RadioButton x:Name="navDocentes" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoDocentes}" Content="Docentes" ToolTip="Docentes"/>

                                <TextBlock x:Name="rotAcademico" Text="ACADÉMICO" Style="{StaticResource Rotulo}" Margin="12,14,0,8"/>
                                <RadioButton x:Name="navMaterias" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoLibro}" Content="Materias" ToolTip="Materias"/>
                                <RadioButton x:Name="navGrados" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoCapas}" Content="Grados y secciones" ToolTip="Grados y secciones"/>
                                <RadioButton x:Name="navPeriodos" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoCalendario}" Content="Períodos" ToolTip="Períodos académicos"/>
                                <RadioButton x:Name="navAsignaciones" GroupName="nav" Style="{StaticResource ItemMenu}"
                                             Tag="{StaticResource IcoAsignaciones}" ToolTip="Asignaciones">
                                    <!-- Mismo tamaño y peso que las demás opciones (se heredan del RadioButton). -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Asignaciones" VerticalAlignment="Center"/>
                                        <!-- Aviso: la API no tiene los endpoints de asignaciones (el código lo muestra) -->
                                        <Border x:Name="pillAsignaciones" Grid.Column="1" Background="{StaticResource AvisoFondoBrush}"
                                                BorderBrush="{StaticResource AvisoBordeBrush}" BorderThickness="1" CornerRadius="9"
                                                Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                ToolTip="No disponible en la API conectada">
                                            <TextBlock Text="No disp." FontSize="10.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource AvisoTextoBrush}"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Usuario logueado + cerrar sesión -->
                    <StackPanel Grid.Row="2">
                        <Border x:Name="tarjetaUsuario" Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Avatar amarillo con la inicial (.avatar de la web) -->
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AmarilloBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="lblInicial" Text="?" FontSize="17" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource AmarilloTextoBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel x:Name="panelUsuarioTextos" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblNombre" Text="Usuario" FontSize="14" FontWeight="ExtraBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border HorizontalAlignment="Left" Background="{StaticResource MentaBrush}" CornerRadius="8"
                                                Padding="8,1,8,2" Margin="0,4,0,0">
                                            <TextBlock x:Name="lblRolBadge" Text="ROL" FontSize="10.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource TealOscuroBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="lblBienvenida" Text="Bienvenido" FontSize="11.5"
                                           Foreground="{StaticResource ApagadoBrush}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnSalir" Style="{StaticResource BtnSalir}" Click="CerrarSesion_Click" ToolTip="Cerrar sesión">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoSalir}" Width="17" Height="17"/>
                                <TextBlock x:Name="txtSalir" Text="Cerrar sesión" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== CONTENIDO ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior: sección actual, indicador de carga y botones de la ventana.
                     Se arrastra para mover la ventana (WindowChrome) y doble clic maximiza. -->
                <Grid Grid.Row="0" Margin="34,16,14,14" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblTitulo" Text="Panel" FontSize="12" FontWeight="ExtraBold"
                                   Foreground="{StaticResource TealOscuroBrush}"/>
                        <TextBlock x:Name="lblSeccionTitulo" Text="Inicio" FontSize="26" FontWeight="ExtraBold" Margin="0,1,0,0"/>
                        <TextBlock x:Name="lblSeccionDescripcion" Text="" FontSize="13.5"
                                   Foreground="{StaticResource ApagadoBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Indicador discreto mientras hay peticiones a la API en curso -->
                        <Border x:Name="panelCargando" Background="{StaticResource Menta2Brush}" CornerRadius="12"
                                Padding="10,6" Margin="0,2,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="estrellaCargando" Style="{StaticResource Icono}" Tag="{StaticResource IcoEstrella}"
                                                Width="15" Height="15" Foreground="{StaticResource AmarilloOscuroBrush}"
                                                RenderTransformOrigin="0.5,0.5">
                                    <ContentControl.RenderTransform>
                                        <RotateTransform/>
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                                <TextBlock Text="Sincronizando…" FontSize="12" FontWeight="Bold" Margin="7,0,0,0"
                                           Foreground="{StaticResource TealOscuroBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource BtnVentana}" Click="Minimizar_Click" ToolTip="Minimizar"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMinimizar}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource BtnVentana}" Click="Maximizar_Click" ToolTip="Maximizar"
                                x:Name="btnMaximizar" WindowChrome.IsHitTestVisibleInChrome="True">
                            <ContentControl x:Name="icoMaximizar" Style="{StaticResource Icono}" Tag="{StaticResource IcoMaximizar}"
                                            Width="15" Height="15"/>
                        </Button>
                        <Button Click="Cerrar_Click" ToolTip="Cerrar" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnVentana}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CoralSuaveBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource CoralTextoBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCerrar}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tarjetas de resumen (ADMIN: conteos reales calculados de las listas de la API;
                     se ven en Inicio) -->
                <UniformGrid x:Name="panelStats" Grid.Row="1" Rows="1" Margin="34,0,20,22"/>

                <Grid Grid.Row="2" Margin="34,0,20,0">
                    <!-- ===== VISTA GENÉRICA (DOCENTE / ESTUDIANTE / otros roles) ===== -->
                    <Grid x:Name="panelGenerico" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna izquierda: lista de datos traídos de la API -->
                        <ContentControl Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="20,18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="lblSeccion" Text="Datos" Style="{StaticResource TituloTarjeta}"
                                           Margin="0,0,0,14"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="listaDatos" Margin="0,0,6,0" Style="{StaticResource Lista}"
                                                  Tag="Cuando la API devuelva datos, aparecerán aquí."/>
                                </ScrollViewer>
                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}">
                                    <TextBlock x:Name="lblEstado" Style="{StaticResource TextoEstado}"/>
                                </Border>
                            </Grid>
                        </ContentControl>

                        <!-- Columna derecha: pestañas Temas / Preguntas / Actividades (solo DOCENTE) -->
                        <TabControl x:Name="tabsDocente" Grid.Column="1" Visibility="Collapsed"
                                    Width="480" Margin="20,0,0,0"
                                    Style="{StaticResource Tabs}" ItemContainerStyle="{StaticResource Tab}">

                            <!-- ===== Temas ===== -->
                            <TabItem Header="Temas">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,14,14,16">
                                            <TextBlock x:Name="lblTemasTitulo" Text="Temas" Style="{StaticResource TituloTarjeta}"
                                                       Margin="0,0,0,14"/>

                                            <TextBlock Text="Nuevo tema" Style="{StaticResource Etiqueta}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtNuevoTema" Tag="Nombre del tema"/>
                                                <Button x:Name="btnCrearTema" Grid.Column="1" Content="＋  Crear tema"
                                                        Margin="10,0,0,0" Style="{StaticResource BtnPrimario}"
                                                        Click="CrearTema_Click"/>
                                            </Grid>

                                            <TextBlock Text="Temas de la materia (elige uno)" Style="{StaticResource Etiqueta}"
                                                       Margin="2,20,0,8"/>
                                            <ItemsControl x:Name="listaTemas"/>
                                            <Border Style="{StaticResource CajaEstado}">
                                                <TextBlock x:Name="lblTemasEstado" Style="{StaticResource TextoEstado}"/>
                                            </Border>

                                            <!-- Subtemas del tema (aparece al elegir un tema) -->
                                            <StackPanel x:Name="panelSubtemas" Visibility="Collapsed">
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock x:Name="lblTemaDetalleTitulo" Text="Tema"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16" Margin="0,0,0,12"/>
                                                <TextBlock Text="Subtemas" Style="{StaticResource Etiqueta}"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtNuevoSubtema" Tag="Nombre del subtema"/>
                                                    <Button x:Name="btnCrearSubtema" Grid.Column="1" Content="＋" MinWidth="50"
                                                            Padding="0" Margin="10,0,0,0" ToolTip="Crear subtema"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearSubtema_Click"/>
                                                </Grid>
                                                <ItemsControl x:Name="listaSubtemas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblSubtemasEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>

                            <!-- ===== Preguntas ===== -->
                            <TabItem Header="Preguntas">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,14,14,16">
                                            <TextBlock Text="Elige un tema en la pestaña «Temas» para crear y ver preguntas."
                                                       Style="{StaticResource AyudaTexto}" Margin="0,0,0,12"/>
                                            <StackPanel x:Name="panelPregunta" Visibility="Collapsed">
                                                <TextBlock x:Name="lblPreguntaTitulo" Text="Crear pregunta"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16" Margin="0,0,0,14"/>

                                                <TextBlock Text="Enunciado" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtEnunciado" Style="{StaticResource CampoMultilinea}"
                                                         Tag="Escribe la pregunta" Margin="0,0,0,12"/>

                                                <TextBlock Text="Explicación (opcional)" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtExplicacion" Style="{StaticResource CampoMultilinea}"
                                                         MinHeight="56" Margin="0,0,0,14"/>

                                                <TextBlock Text="Opciones (marca la correcta)" Style="{StaticResource Etiqueta}"
                                                           Margin="2,0,0,8"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp1" GroupName="OpcionCorrecta" IsChecked="True"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp1" Grid.Column="1" MinHeight="42" Tag="Opción 1"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp2" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp2" Grid.Column="1" MinHeight="42" Tag="Opción 2"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp3" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp3" Grid.Column="1" MinHeight="42" Tag="Opción 3"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="rbOp4" GroupName="OpcionCorrecta"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox x:Name="txtOp4" Grid.Column="1" MinHeight="42" Tag="Opción 4"/>
                                                </Grid>

                                                <Button x:Name="btnCrearPregunta" Content="＋  Crear pregunta"
                                                        Style="{StaticResource BtnPrimario}" Click="CrearPregunta_Click"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPreguntaEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>

                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock Text="Preguntas del tema" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                                <ItemsControl x:Name="listaPreguntas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPreguntasEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>

                            <!-- ===== Actividades ===== -->
                            <TabItem Header="Actividades">
                                <ContentControl Style="{StaticResource Tarjeta}" Padding="4" Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="panelActividades" Visibility="Collapsed" Margin="16,14,14,16">
                                            <TextBlock Text="Crear, publicar y gestionar actividades."
                                                       Style="{StaticResource AyudaTexto}" Margin="0,0,0,12"/>

                                            <Border Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}"
                                                    BorderThickness="1.5" CornerRadius="20" Padding="16" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="Nueva actividad" Style="{StaticResource TituloTarjeta}" FontSize="16"/>
                                                    <TextBlock Text="Nace en borrador." Style="{StaticResource SubtituloTarjeta}"
                                                               Margin="0,2,0,14"/>

                                                    <TextBlock Text="Título" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtActTitulo" Tag="Título de la actividad" Margin="0,0,0,12"/>

                                                    <TextBlock Text="Descripción (opcional)" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtActDescripcion" Style="{StaticResource CampoMultilinea}"
                                                             MinHeight="56" Margin="0,0,0,12"/>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActMateria" SelectionChanged="ActMateria_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <TextBlock Text="Tema" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActTema"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Modo de dificultad" Style="{StaticResource Etiqueta}"/>
                                                            <ComboBox x:Name="cmbActModo" SelectedIndex="0">
                                                                <ComboBoxItem>MANUAL</ComboBoxItem>
                                                                <ComboBoxItem>ADAPTATIVA</ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <TextBlock Text="Tipo actividad (id)" Style="{StaticResource Etiqueta}"/>
                                                            <TextBox x:Name="txtActTipoId" Text="1"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="Nivel inicial (id)" Style="{StaticResource Etiqueta}"/>
                                                            <TextBox x:Name="txtActNivelId" Text="1"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                                            <CheckBox x:Name="chkRecuperacion" Content="Recuperación activa"
                                                                      FontSize="13" Margin="0,0,0,8"/>
                                                            <CheckBox x:Name="chkRecompensas" Content="Recompensas activas"
                                                                      FontSize="13" IsChecked="True" Margin="0,0,0,4"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Button x:Name="btnCrearActividad" Content="＋  Crear actividad"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearActividad_Click"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Tus actividades" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                            <ItemsControl x:Name="listaActividades"/>
                                            <Border Style="{StaticResource CajaEstado}">
                                                <TextBlock x:Name="lblActividadesEstado" Style="{StaticResource TextoEstado}"/>
                                            </Border>

                                            <!-- Asignar preguntas del banco a la actividad elegida -->
                                            <StackPanel x:Name="panelAsignarPreguntas" Visibility="Collapsed">
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,18"/>
                                                <TextBlock x:Name="lblAsignarTitulo" Text="Asignar preguntas"
                                                           Style="{StaticResource TituloTarjeta}" FontSize="16"/>
                                                <TextBlock Text="Preguntas del tema de la actividad. Pulsa «Agregar» para añadirlas."
                                                           Style="{StaticResource SubtituloTarjeta}" Margin="0,3,0,12"/>
                                                <ItemsControl x:Name="listaBancoPreguntas"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblAsignarEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>

                                                <!-- Estado y publicación de la actividad -->
                                                <Border Height="1.5" Background="{StaticResource BordeBrush}" Margin="0,20,0,16"/>
                                                <WrapPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Estado:" FontSize="13" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                                                    <Border x:Name="brdEstadoActual" CornerRadius="11"
                                                            Background="{StaticResource NeutroSuaveBrush}"
                                                            Padding="10,3" VerticalAlignment="Center" Margin="0,0,6,6">
                                                        <TextBlock x:Name="lblEstadoActual" Text="—" FontSize="11" FontWeight="ExtraBold"
                                                                   Foreground="{StaticResource ApagadoBrush}"/>
                                                    </Border>
                                                    <Button x:Name="btnEstadoPublicar" Content="Publicar actividad"
                                                            Style="{StaticResource BtnAccion}" Margin="0,0,6,6"
                                                            Background="{StaticResource VerdeSuaveBrush}"
                                                            Foreground="{StaticResource VerdeBrush}"
                                                            BorderBrush="{StaticResource VerdeBrush}"
                                                            Click="EstadoPublicar_Click"/>
                                                    <Button x:Name="btnEstadoCerrar" Content="Cerrar actividad"
                                                            Style="{StaticResource BtnAccion}" Margin="0,0,0,6"
                                                            Background="{StaticResource CoralSuaveBrush}"
                                                            Foreground="{StaticResource CoralBrush}"
                                                            BorderBrush="{StaticResource CoralBrush}"
                                                            Click="EstadoCerrar_Click"/>
                                                </WrapPanel>

                                                <Border Background="{StaticResource FondoBrush}" BorderBrush="{StaticResource BordeBrush}"
                                                        BorderThickness="1.5" CornerRadius="20" Padding="16" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="Publicar a una sección" Style="{StaticResource TituloTarjeta}"
                                                                   FontSize="16" Margin="0,0,0,14"/>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                                <ComboBox x:Name="cmbPubSeccion"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                                <ComboBox x:Name="cmbPubPeriodo"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Apertura" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubApertura" Tag="yyyy-MM-dd HH:mm"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Cierre" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubCierre" Tag="yyyy-MM-dd HH:mm"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                                <TextBlock Text="Máx. intentos" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubIntentos" Text="1"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="Duración (min)" Style="{StaticResource Etiqueta}"/>
                                                                <TextBox x:Name="txtPubDuracion" Tag="Opcional"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Button x:Name="btnPublicarSeccion" Content="＋  Publicar a la sección"
                                                                Style="{StaticResource BtnPrimario}" Click="PublicarSeccion_Click"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Publicada en" Style="{StaticResource Etiqueta}" Margin="2,0,0,8"/>
                                                <ItemsControl x:Name="listaPubSecciones"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblPublicarEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </ContentControl>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <!-- ===== FIN VISTA GENÉRICA ===== -->

                    <!-- ===== VISTA ADMIN: una sección por opción del menú (sin barra de pestañas) ===== -->
                    <TabControl x:Name="panelAdmin" Grid.Row="2" Visibility="Collapsed"
                                Style="{StaticResource TabsSinCabecera}"
                                SelectionChanged="PanelAdmin_SelectionChanged">

                        <!-- ===== Inicio: accesos rápidos (los conteos están arriba) ===== -->
                        <TabItem x:Name="tabInicio" Header="Inicio">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,14,24">
                                    <!-- Aviso de funciones no disponibles (el mismo del menú) -->
                                    <Border Style="{StaticResource CajaEstado}" Margin="0,0,0,20"
                                            Background="{StaticResource AvisoFondoBrush}" BorderBrush="{StaticResource AvisoBordeBrush}"
                                            Visibility="{Binding Visibility, ElementName=pillAsignaciones}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoAviso}" Width="18" Height="18"
                                                            Foreground="{StaticResource AvisoTextoBrush}" VerticalAlignment="Top"
                                                            Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TextoEstado}"
                                                       Foreground="{StaticResource AvisoTextoBrush}"
                                                       Text="{Binding ToolTip, ElementName=pillAsignaciones}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Accesos rápidos" Style="{StaticResource TituloTarjeta}" Margin="2,0,0,4"/>
                                    <TextBlock Text="Ve directo a la sección que necesitas gestionar." Style="{StaticResource SubtituloTarjeta}"
                                               Margin="2,0,0,16"/>
                                    <UniformGrid x:Name="gridAccesos" Columns="3">
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoUsuarios}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navUsuarios}">
                                            <StackPanel>
                                                <TextBlock Text="Usuarios" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Cuentas, roles y acceso." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoEstudiantes}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navEstudiantes}">
                                            <StackPanel>
                                                <TextBlock Text="Estudiantes" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Altas, bajas y sección." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoDocentes}"
                                                Background="{StaticResource MoradoSuaveBrush}" BorderBrush="{StaticResource MoradoTextoBrush}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navDocentes}">
                                            <StackPanel>
                                                <TextBlock Text="Docentes" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Altas, bajas y sus clases." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoLibro}"
                                                Background="{StaticResource AmarilloSuaveBrush}" BorderBrush="{StaticResource AmarilloTextoSuaveBrush}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navMaterias}">
                                            <StackPanel>
                                                <TextBlock Text="Materias" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Catálogo de materias." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoCapas}"
                                                Background="{StaticResource InfoFondoBrush}" BorderBrush="{StaticResource InfoTextoBrush}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navGrados}">
                                            <StackPanel>
                                                <TextBlock Text="Grados y secciones" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Estructura académica." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoCalendario}"
                                                Background="{StaticResource MoradoSuaveBrush}" BorderBrush="{StaticResource MoradoTextoBrush}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navPeriodos}">
                                            <StackPanel>
                                                <TextBlock Text="Períodos" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Fechas de cada período." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Acceso}" Tag="{StaticResource IcoAsignaciones}"
                                                Click="Acceso_Click" CommandParameter="{Binding ElementName=navAsignaciones}">
                                            <StackPanel>
                                                <TextBlock Text="Asignaciones" FontSize="15.5" FontWeight="ExtraBold"/>
                                                <TextBlock Text="Clases y secciones." FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ApagadoBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===== Usuarios ===== -->
                        <TabItem x:Name="tabUsuarios" Header="Usuarios">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,22,30" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource MentaBrush}">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}"
                                                                    Foreground="{StaticResource TealOscuroBrush}"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Nuevo usuario" Style="{StaticResource TituloTarjeta}"/>
                                                    <TextBlock Text="Se crea activo." Style="{StaticResource AyudaTexto}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="Nombre completo" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNombreCompleto" Tag="Ej.: Ana Pérez" Margin="0,0,0,14"
                                                     MaxLength="150"/>

                                            <TextBlock Text="Usuario o correo" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtCorreoUsuario" Tag="usuario o nombre@colegio.edu" Margin="0,0,0,14"
                                                     MaxLength="120"/>

                                            <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}"/>
                                            <PasswordBox x:Name="pwdClave" Margin="0,0,0,5" MaxLength="128"/>
                                            <TextBlock Text="Entre 8 y 128 caracteres." Style="{StaticResource AyudaTexto}" Margin="3,0,0,14"/>

                                            <!-- Los roles (id y código) se cargan de GET api/roles. -->
                                            <TextBlock Text="Rol" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbRol" Margin="0,0,0,22"/>

                                            <Button x:Name="btnCrearUsuario" Style="{StaticResource BtnPrimario}" Click="CrearUsuario_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                    <TextBlock Text="Crear usuario" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Margin="18,16,18,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="172"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtBuscarUsuario" Style="{StaticResource CampoBusqueda}"
                                                         Tag="Buscar por nombre o usuario…" TextChanged="BuscarUsuario_Changed"/>
                                                <ComboBox x:Name="cmbFiltroRolUsuarios" Grid.Column="1" Margin="10,0,0,0"
                                                          SelectedIndex="0" SelectionChanged="FiltroUsuarios_Changed" ToolTip="Filtrar por rol">
                                                    <ComboBoxItem>Todos los roles</ComboBoxItem>
                                                    <ComboBoxItem Tag="ADMIN">Administradores</ComboBoxItem>
                                                    <ComboBoxItem Tag="DOCENTE">Docentes</ComboBoxItem>
                                                    <ComboBoxItem Tag="ESTUDIANTE">Estudiantes</ComboBoxItem>
                                                </ComboBox>
                                                <ComboBox x:Name="cmbFiltroEstadoUsuarios" Grid.Column="2" Margin="10,0,0,0"
                                                          SelectedIndex="0" SelectionChanged="FiltroUsuarios_Changed" ToolTip="Filtrar por estado">
                                                    <ComboBoxItem>Todos</ComboBoxItem>
                                                    <ComboBoxItem>Activos</ComboBoxItem>
                                                    <ComboBoxItem>De baja</ComboBoxItem>
                                                </ComboBox>
                                            </Grid>
                                            <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="1" Text="USUARIO · ROL · ESTADO" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="listaUsuarios" Style="{StaticResource Lista}"
                                                              Tag="Crea el primero con el formulario o cambia los filtros."/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="pagUsuarios" Grid.Row="3" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                        </Grid>
                                    </ContentControl>
                                    <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblUsuariosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Estudiantes: baja / reactivación y sección (lista de api/Usuarios por rol) ===== -->
                        <TabItem x:Name="tabEstudiantes" Header="Estudiantes">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentControl Style="{StaticResource TarjetaTabla}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,16,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtBuscarEstAdmin" Style="{StaticResource CampoBusqueda}"
                                                     Tag="Buscar estudiante por nombre o usuario…"
                                                     TextChanged="BuscarEstAdmin_Changed"/>
                                            <ComboBox x:Name="cmbFiltroEstAdmin" Grid.Column="1" Margin="10,0,0,0"
                                                      SelectedIndex="0" SelectionChanged="FiltroEstAdmin_Changed" ToolTip="Filtrar por estado">
                                                <ComboBoxItem>Todos</ComboBoxItem>
                                                <ComboBoxItem>Activos</ComboBoxItem>
                                                <ComboBoxItem>De baja</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                <TextBlock Grid.Column="1" Text="ESTUDIANTE · SECCIÓN · ESTADO" Style="{StaticResource Rotulo}"/>
                                                <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="listaEstAdmin" Style="{StaticResource Lista}"
                                                          Tag="Los estudiantes se crean en «Usuarios» con el rol ESTUDIANTE."/>
                                        </ScrollViewer>
                                        <StackPanel x:Name="pagEstAdmin" Grid.Row="3" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                    </Grid>
                                </ContentControl>
                                <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                    <TextBlock x:Name="lblEstAdminEstado" Style="{StaticResource TextoEstado}"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ===== Docentes: baja / reactivación y sus clases ===== -->
                        <TabItem x:Name="tabDocentes" Header="Docentes">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lista de docentes -->
                                <Grid Grid.Column="0" Margin="0,0,11,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Margin="18,16,18,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtBuscarDocente" Style="{StaticResource CampoBusqueda}"
                                                         Tag="Buscar docente…" TextChanged="BuscarDocente_Changed"/>
                                                <ComboBox x:Name="cmbFiltroEstadoDocentes" Grid.Column="1" Margin="10,0,0,0"
                                                          SelectedIndex="0" SelectionChanged="FiltroDocentes_Changed" ToolTip="Filtrar por estado">
                                                    <ComboBoxItem>Todos</ComboBoxItem>
                                                    <ComboBoxItem>Activos</ComboBoxItem>
                                                    <ComboBoxItem>De baja</ComboBoxItem>
                                                </ComboBox>
                                            </Grid>
                                            <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="1" Text="DOCENTE · CLASES · ESTADO" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="listaDocentes" Style="{StaticResource Lista}"
                                                              Tag="Los docentes se crean en «Usuarios» con el rol DOCENTE."/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="pagDocentes" Grid.Row="3" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                        </Grid>
                                    </ContentControl>
                                    <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblDocentesEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>

                                <!-- Clases del docente elegido (api/admin/asignaciones-docente) -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="11,0,0,0">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,6,30" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource MoradoSuaveBrush}">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoAsignaciones}"
                                                                    Foreground="{StaticResource MoradoTextoBrush}"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Clases del docente" Style="{StaticResource TituloTarjeta}"/>
                                                    <TextBlock x:Name="lblClasesDocenteInfo"
                                                               Text="Elige un docente (botón «Clases») para ver y gestionar sus clases."
                                                               Style="{StaticResource AyudaTexto}" MaxWidth="320" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="panelClasesDocente" Visibility="Collapsed" Margin="0,20,0,0">
                                                <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                <ComboBox x:Name="cmbClaseMateria" Margin="0,0,0,14"/>
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbClaseSeccion"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                        <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbClasePeriodo"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Button x:Name="btnAgregarClase" Style="{StaticResource BtnPrimario}" Click="AgregarClase_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                        <TextBlock Text="Asignar clase" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Border Height="1" Background="{StaticResource LineaSuaveBrush}" Margin="0,22,0,6"/>
                                                <ItemsControl x:Name="listaClasesDocente" Margin="-18,0,-18,0"/>
                                                <Border Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblClasesDocenteEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- ===== Materias ===== -->
                        <TabItem x:Name="tabMaterias" Header="Materias">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,22,30" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AmarilloSuaveBrush}">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoLibro}"
                                                                    Foreground="{StaticResource AmarilloTextoSuaveBrush}"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Nueva materia" Style="{StaticResource TituloTarjeta}"/>
                                                    <TextBlock Text="Se crea activa; puedes desactivarla al editarla." Style="{StaticResource AyudaTexto}"
                                                               MaxWidth="210" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNuevaMateria" Tag="Ej.: Matemáticas" MaxLength="80"/>
                                            <Button x:Name="btnCrear" Margin="0,22,0,0" Style="{StaticResource BtnPrimario}" Click="CrearMateria_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                    <TextBlock Text="Crear materia" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Margin="18,16,18,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtBuscarMateria" Style="{StaticResource CampoBusqueda}"
                                                         Tag="Buscar materia por nombre…" TextChanged="BuscarMateria_Changed"/>
                                                <ComboBox x:Name="cmbFiltroEstadoMaterias" Grid.Column="1" Margin="10,0,0,0"
                                                          SelectedIndex="0" SelectionChanged="FiltroMaterias_Changed" ToolTip="Filtrar por estado">
                                                    <ComboBoxItem>Todas</ComboBoxItem>
                                                    <ComboBoxItem>Activas</ComboBoxItem>
                                                    <ComboBoxItem>Inactivas</ComboBoxItem>
                                                </ComboBox>
                                            </Grid>
                                            <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="1" Text="MATERIA · ESTADO" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="listaMaterias" Style="{StaticResource Lista}"
                                                              Tag="Crea la primera con el formulario o cambia los filtros."/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="pagMaterias" Grid.Row="3" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                        </Grid>
                                    </ContentControl>
                                    <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblMateriasEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Grados y Secciones ===== -->
                        <TabItem x:Name="tabGrados" Header="Grados y secciones">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Grados -->
                                <Grid Grid.Column="0" Margin="0,0,11,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="22,20,22,18">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource InfoFondoBrush}">
                                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCapas}"
                                                                        Foreground="{StaticResource InfoTextoBrush}"/>
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Grados" Style="{StaticResource TituloTarjeta}"/>
                                                        <TextBlock Text="«Secciones» abre las secciones de ese grado." Style="{StaticResource AyudaTexto}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtNuevoGrado" Tag="Nombre del grado" MaxLength="50"/>
                                                    <TextBox x:Name="txtOrdenGrado" Grid.Column="1" Text="1" Tag="Orden" MaxLength="3"
                                                             Margin="8,0,0,0" ToolTip="Orden (0-255). Déjalo vacío si no aplica."/>
                                                    <Button x:Name="btnCrearGrado" Grid.Column="2" Padding="16,0" Margin="8,0,0,0"
                                                            Style="{StaticResource BtnPrimario}" Click="CrearGrado_Click" ToolTip="Crear grado">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                            <TextBlock Text="Crear" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                            <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="1" Text="GRADO · ORDEN" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="listaGrados" Style="{StaticResource Lista}"
                                                              Tag="Crea el primer grado con el formulario de arriba."/>
                                            </ScrollViewer>
                                        </Grid>
                                    </ContentControl>
                                    <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblGradosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>

                                <!-- Secciones -->
                                <Grid Grid.Column="1" Margin="11,0,0,0">
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="22,20,22,18">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource MentaBrush}">
                                                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoUsuarios}"
                                                                        Foreground="{StaticResource TealOscuroBrush}"/>
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Secciones" Style="{StaticResource TituloTarjeta}"/>
                                                        <TextBlock x:Name="lblSeccionesInfo"
                                                                   Text="Elige un grado (botón «Secciones») para gestionar sus secciones."
                                                                   Style="{StaticResource AyudaTexto}" MaxWidth="300" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- El formulario se muestra junto con panelSecciones (al elegir un grado). -->
                                                <StackPanel Visibility="{Binding Visibility, ElementName=panelSecciones}" Margin="0,16,0,0">
                                                    <TextBlock x:Name="lblSeccionesTitulo" Text="Nueva sección" Style="{StaticResource Etiqueta}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtNuevaSeccion" Tag="Ej.: A" MaxLength="30"/>
                                                        <Button x:Name="btnCrearSeccion" Grid.Column="1" Padding="16,0" Margin="8,0,0,0"
                                                                Style="{StaticResource BtnPrimario}" Click="CrearSeccion_Click" ToolTip="Crear sección">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                                <TextBlock Text="Crear" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Estado vacío (queda detrás de la lista) -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        IsHitTestVisible="False" Margin="24">
                                                <Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource MentaBrush}">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoEstrella}"
                                                                    Foreground="{StaticResource TealBrush}" Width="24" Height="24"/>
                                                </Border>
                                                <TextBlock Text="Aquí verás las secciones del grado que elijas."
                                                           Style="{StaticResource AyudaTexto}" TextAlignment="Center"
                                                           MaxWidth="240" Margin="0,12,0,0"/>
                                            </StackPanel>

                                            <Grid x:Name="panelSecciones" Grid.Row="1" Visibility="Collapsed" Background="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource CabeceraTabla}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                        <TextBlock Grid.Column="1" Text="SECCIÓN · ESTADO" Style="{StaticResource Rotulo}"/>
                                                        <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="listaSecciones" Style="{StaticResource Lista}"
                                                                  Tag="Crea la primera sección con el formulario de arriba."/>
                                                </ScrollViewer>
                                                <Border Grid.Row="2" Style="{StaticResource CajaEstado}" Margin="14,10,14,14">
                                                    <TextBlock x:Name="lblSeccionesEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ContentControl>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Períodos ===== -->
                        <TabItem x:Name="tabPeriodos" Header="Períodos">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,22,30" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource MoradoSuaveBrush}">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoCalendario}"
                                                                    Foreground="{StaticResource MoradoTextoBrush}"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Nuevo período" Style="{StaticResource TituloTarjeta}"/>
                                                    <TextBlock Text="Fechas en formato AAAA-MM-DD." Style="{StaticResource AyudaTexto}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtNombrePeriodo" Tag="Ej.: Año lectivo 2026" Margin="0,0,0,14"
                                                     MaxLength="50"/>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Fecha inicio" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtFechaInicio" Tag="AAAA-MM-DD" MaxLength="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Fecha fin" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtFechaFin" Tag="AAAA-MM-DD" MaxLength="10"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="chkActivoPeriodo" Content="Activo" IsChecked="True"
                                                      Margin="2,0,0,22"/>

                                            <Button x:Name="btnCrearPeriodo" Style="{StaticResource BtnPrimario}" Click="CrearPeriodo_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                    <TextBlock Text="Crear período" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource TarjetaTabla}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource CabeceraTabla}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="1" Text="PERÍODO · FECHAS · ESTADO" Style="{StaticResource Rotulo}"/>
                                                    <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="listaPeriodos" Style="{StaticResource Lista}"
                                                              Tag="Crea el primer período con el formulario."/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="pagPeriodos" Grid.Row="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                        </Grid>
                                    </ContentControl>
                                    <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                        <TextBlock x:Name="lblPeriodosEstado" Style="{StaticResource TextoEstado}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== Asignaciones: docentes a materia + sección y estudiantes a sección ===== -->
                        <TabItem x:Name="tabAsignaciones" Header="Asignaciones">
                            <Grid>
                                <!-- Nota (solo se ve si AsignacionesDisponibles = false en el código) -->
                                <ScrollViewer x:Name="panelAsignacionesNota" VerticalScrollBarVisibility="Auto"
                                              Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource Tarjeta}" Padding="30,26" Margin="0,0,0,26"
                                                    MaxWidth="640" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <Border Width="52" Height="52" CornerRadius="17" HorizontalAlignment="Left"
                                                    Background="{StaticResource AvisoFondoBrush}">
                                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoAviso}"
                                                                Foreground="{StaticResource AvisoTextoBrush}" Width="24" Height="24"/>
                                            </Border>
                                            <TextBlock Text="Asignaciones desactivadas" Style="{StaticResource TituloTarjeta}"
                                                       FontSize="20" Margin="0,14,0,0"/>
                                            <TextBlock Style="{StaticResource AyudaTexto}" FontSize="14" Margin="0,8,0,0"
                                                       Text="Esta pestaña está desactivada en esta versión de la app, así que no hace ninguna llamada a la API desde aquí."/>
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>

                                <!-- Formularios de asignación -->
                                <TabControl x:Name="panelAsignacionesForm"
                                            Style="{StaticResource TabsSub}" ItemContainerStyle="{StaticResource TabSub}">

                                    <!-- ===== Docente -> materia + sección (api/admin/asignaciones-docente) ===== -->
                                    <TabItem Header="Docentes → materia y sección">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="330"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,22,30" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="Asignar docente a clase" Style="{StaticResource TituloTarjeta}"
                                                                   Margin="0,0,0,16"/>

                                                        <TextBlock Text="Docente" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigDocente" Margin="0,0,0,14"/>

                                                        <TextBlock Text="Materia" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigMateria" Margin="0,0,0,14"/>

                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigSeccion" Margin="0,0,0,14"/>

                                                        <TextBlock Text="Período académico" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbAsigPeriodo" Margin="0,0,0,22"/>

                                                        <Button x:Name="btnCrearAsignacion" Style="{StaticResource BtnPrimario}"
                                                                Click="CrearAsignacion_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                                <TextBlock Text="Asignar docente" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </ContentControl>
                                            </ScrollViewer>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ContentControl Style="{StaticResource TarjetaTabla}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Style="{StaticResource CabeceraTabla}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                                <TextBlock Grid.Column="1" Text="DOCENTE · MATERIA · SECCIÓN · PERÍODO" Style="{StaticResource Rotulo}"/>
                                                                <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="listaAsignaciones" Style="{StaticResource Lista}"
                                                                          Tag="Las clases asignadas a los docentes aparecerán aquí."/>
                                                        </ScrollViewer>
                                                        <StackPanel x:Name="pagAsignaciones" Grid.Row="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                                    </Grid>
                                                </ContentControl>
                                                <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblAsignacionesEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </TabItem>

                                    <!-- ===== Estudiante -> sección (api/admin/estudiantes-seccion) ===== -->
                                    <TabItem Header="Estudiantes → sección">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="330"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Style="{StaticResource Tarjeta}" Margin="0,0,22,30" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <TextBlock Text="Asignar estudiante a sección" Style="{StaticResource TituloTarjeta}"/>
                                                        <TextBlock Text="Si ya tiene sección, se cambia a la nueva."
                                                                   Style="{StaticResource SubtituloTarjeta}"/>

                                                        <TextBlock Text="Estudiante" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbEstEstudiante" Margin="0,0,0,14"/>

                                                        <TextBlock Text="Sección" Style="{StaticResource Etiqueta}"/>
                                                        <ComboBox x:Name="cmbEstSeccion" Margin="0,0,0,22"/>

                                                        <Button x:Name="btnAsignarEstudiante" Style="{StaticResource BtnPrimario}"
                                                                Click="AsignarEstudiante_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoMas}" Width="16" Height="16"/>
                                                                <TextBlock Text="Asignar a la sección" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="Tip: «Asignar» o «Cambiar» en la lista deja elegido al estudiante aquí."
                                                                   Style="{StaticResource AyudaTexto}" Margin="2,14,0,0"/>
                                                    </StackPanel>
                                                </ContentControl>
                                            </ScrollViewer>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ContentControl Style="{StaticResource TarjetaTabla}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBox x:Name="txtBuscarEstudiante" Style="{StaticResource CampoBusqueda}"
                                                                 Tag="Buscar estudiante por nombre…" Margin="18,16,18,14"
                                                                 TextChanged="BuscarEstudiante_Changed"/>
                                                        <Border Grid.Row="1" Style="{StaticResource CabeceraTabla}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="#" Style="{StaticResource Rotulo}"/>
                                                                <TextBlock Grid.Column="1" Text="ESTUDIANTE · SECCIÓN" Style="{StaticResource Rotulo}"/>
                                                                <TextBlock Grid.Column="2" Text="ACCIONES" Style="{StaticResource Rotulo}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="listaEstudiantesSeccion" Style="{StaticResource Lista}"
                                                                          Tag="Los estudiantes con su sección aparecerán aquí."/>
                                                        </ScrollViewer>
                                                        <StackPanel x:Name="pagEstudiantesSeccion" Grid.Row="3" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right" Margin="12,8,12,8"/>
                                                    </Grid>
                                                </ContentControl>
                                                <Border Grid.Row="1" Style="{StaticResource CajaEstado}">
                                                    <TextBlock x:Name="lblEstudiantesEstado" Style="{StaticResource TextoEstado}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <!-- ===== FIN VISTA ADMIN ===== -->
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

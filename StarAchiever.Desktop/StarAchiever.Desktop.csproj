<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuente Nunito (SIL Open Font License, ver Fonts/OFL.txt) embebida en la app. -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Logo de Star-Achiever (el mismo de la web docente: wwwroot/assets/logo-original.png).
         Para cambiarlo basta con reemplazar Assets\logo.png. -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>

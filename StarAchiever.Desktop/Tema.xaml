<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- =====================================================================
         TEMA CLARO STAR-ACHIEVER (misma paleta que la versión web)
         ===================================================================== -->

    <!-- ===== Paleta ===== -->
    <SolidColorBrush x:Key="FondoBrush" Color="#F8FCFF"/>          <!-- fondo general -->
    <SolidColorBrush x:Key="NavyBrush" Color="#0B1B57"/>           <!-- texto y títulos -->
    <SolidColorBrush x:Key="TealBrush" Color="#08AAA8"/>           <!-- color principal -->
    <SolidColorBrush x:Key="TealOscuroBrush" Color="#087D80"/>
    <SolidColorBrush x:Key="AmarilloBrush" Color="#FFD10A"/>       <!-- botones de acción -->
    <SolidColorBrush x:Key="AmarilloTextoBrush" Color="#0A174D"/>  <!-- texto sobre amarillo -->
    <SolidColorBrush x:Key="MoradoBrush" Color="#7442D7"/>
    <SolidColorBrush x:Key="CoralBrush" Color="#FF6F85"/>
    <SolidColorBrush x:Key="VerdeBrush" Color="#12A675"/>
    <SolidColorBrush x:Key="MentaBrush" Color="#DFF8F5"/>          <!-- fondos suaves -->
    <SolidColorBrush x:Key="ApagadoBrush" Color="#64729A"/>        <!-- texto secundario -->
    <SolidColorBrush x:Key="BordeBrush" Color="#D9E9F2"/>

    <!-- Versiones suaves: los mismos colores de la paleta con transparencia. -->
    <SolidColorBrush x:Key="MoradoSuaveBrush" Color="#1F7442D7"/>
    <SolidColorBrush x:Key="CoralSuaveBrush" Color="#24FF6F85"/>
    <SolidColorBrush x:Key="VerdeSuaveBrush" Color="#2212A675"/>
    <SolidColorBrush x:Key="AmarilloSuaveBrush" Color="#40FFD10A"/>
    <SolidColorBrush x:Key="NeutroSuaveBrush" Color="#0F0B1B57"/>
    <SolidColorBrush x:Key="TealMedioBrush" Color="#8008AAA8"/>
    <SolidColorBrush x:Key="BlancoTranslucidoBrush" Color="#2EFFFFFF"/>

    <!-- Estados hover / pressed de los botones grandes. -->
    <SolidColorBrush x:Key="AmarilloHoverBrush" Color="#F7C600"/>
    <SolidColorBrush x:Key="AmarilloPressedBrush" Color="#EDBC00"/>
    <SolidColorBrush x:Key="CoralHoverBrush" Color="#F65A73"/>

    <!-- ===== Tipografía: Nunito embebida (Fonts/), con Segoe UI de respaldo ===== -->
    <FontFamily x:Key="FuenteApp">./Fonts/#Nunito, Segoe UI</FontFamily>

    <!-- ===== Sombras (tipo 0 14px 35px rgba(31,68,107,.08) de la web) ===== -->
    <DropShadowEffect x:Key="SombraSuave" Color="#1F446B" Direction="270" ShadowDepth="12"
                      BlurRadius="35" Opacity="0.12" po:Freeze="True"/>
    <DropShadowEffect x:Key="SombraVentana" Color="#1F446B" Direction="270" ShadowDepth="6"
                      BlurRadius="28" Opacity="0.22" po:Freeze="True"/>

    <!-- ===== Textos ===== -->
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SubtituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,16"/>
    </Style>

    <Style x:Key="AyudaTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Mensajes de estado (✓ / ✗): el código pinta la caja de verde o coral. -->
    <Style x:Key="CajaEstado" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="{StaticResource NeutroSuaveBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
    </Style>
    <Style x:Key="TextoEstado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Tarjetas ===== -->
    <!-- Tarjeta blanca muy redondeada. La sombra va en un borde aparte (detrás) para que
         el contenido no se tenga que re-dibujar con el efecto cada vez que cambia. -->
    <Style x:Key="Tarjeta" TargetType="ContentControl">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="24" Background="White" Effect="{StaticResource SombraSuave}"/>
                        <Border CornerRadius="24" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botones ===== -->
    <!-- Contorno de foco redondeado (solo al navegar con teclado). -->
    <Style x:Key="FocoRedondeado">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="26" Margin="-3" BorderThickness="2"
                            BorderBrush="{StaticResource TealBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base de los botones grandes y redondeados. -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="23" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amarillo: acción principal (Crear, Guardar, Ingresar…). -->
    <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AmarilloBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AmarilloTextoBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmarilloHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AmarilloPressedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Blanco con borde: Cancelar y similares. -->
    <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MentaBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Coral: acciones destructivas (confirmar eliminación). -->
    <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource CoralBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CoralHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón pill de las filas (Editar, Eliminar…). Background = color suave,
         Foreground = color fuerte y BorderBrush = color fuerte (se usa al pasar el mouse). -->
    <Style x:Key="BtnAccion" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource MentaBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón redondo para cerrar la ventana. -->
    <Style x:Key="BtnCerrar" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="19">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CoralSuaveBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Campos de texto (estilo por defecto) =====
         Tag = texto de ayuda (placeholder) que se ve cuando el campo está vacío. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource ApagadoBrush}" Opacity="0.8" FontWeight="Normal"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de varias líneas (enunciados, descripciones). -->
    <Style x:Key="CampoMultilinea" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox y RadioButton ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="caja" Width="22" Height="22" CornerRadius="7" Background="White"
                                BorderBrush="{StaticResource BordeBrush}" BorderThickness="2"
                                VerticalAlignment="Center">
                            <Path x:Name="check" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caja" Property="Background" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse x:Name="aro" Fill="White" Stroke="{StaticResource BordeBrush}" StrokeThickness="2"/>
                            <Ellipse x:Name="punto" Width="12" Height="12" Fill="{StaticResource TealBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="aro" Property="Stroke" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="aro" Property="Stroke" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="aro" Property="Fill" Value="{StaticResource MentaBrush}"/>
                            <Setter TargetName="punto" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="White" CornerRadius="16"
                                            BorderBrush="{StaticResource BordeBrush}" BorderThickness="1.5"
                                            Padding="14,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14"
                                                    Background="{StaticResource MentaBrush}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Path Data="M0,0 L10,0 L5,6 Z" Fill="{StaticResource TealOscuroBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="White" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1.5"
                                    CornerRadius="16" Padding="6" Margin="0,6,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="cont" Background="Transparent" CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="cont" Property="Background" Value="{StaticResource MentaBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="cont" Property="Background" Value="{StaticResource TealBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pestañas: pills dentro de una barra blanca redondeada ===== -->
    <Style x:Key="Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="1.5" CornerRadius="24" Padding="5"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La letra del encabezado se define en el ContentPresenter (y no en el TabItem)
         para que el contenido de la pestaña no herede ni el color ni la negrita. -->
    <Style x:Key="Tab" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tab" CornerRadius="19" Background="Transparent" Padding="18,9" Margin="1,0">
                        <ContentPresenter x:Name="hdr" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource ApagadoBrush}"
                                          TextElement.FontWeight="ExtraBold" TextElement.FontSize="13.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource MentaBrush}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="tab" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barras de desplazamiento finas y redondeadas ===== -->
    <Style x:Key="ScrollPagina" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="{StaticResource BordeBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="3,4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="4,3">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ToolTip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

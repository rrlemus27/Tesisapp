    <!-- Icono de trazo: Tag = geometría (24x24), color = Foreground (se hereda). -->
    <Style x:Key="Icono" TargetType="ContentControl">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Textos ===== -->
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>

    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SubtituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="0,4,0,18"/>
    </Style>

    <Style x:Key="AyudaTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Rótulo pequeño en mayúsculas (grupos del menú, cabeceras de tabla). -->
    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Notificación en línea (✓ / ✗ / aviso / info). El código (Ui.Notificacion) pone el
         icono y el color según el tipo de mensaje. -->
    <Style x:Key="CajaEstado" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadioControl}"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource InfoFondoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBordeBrush}"/>
    </Style>
    <Style x:Key="TextoEstado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- ===== Tarjetas (.panel de la web) ===== -->
    <!-- La sombra va en un borde aparte (detrás) para que el contenido no se re-dibuje con el efecto. -->
    <Style x:Key="Tarjeta" TargetType="ContentControl">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="{StaticResource Radio}" Background="White" Effect="{StaticResource SombraSuave}"/>
                        <Border CornerRadius="{StaticResource Radio}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta que contiene una tabla: sin relleno (las filas llegan al borde) y recortada. -->
    <Style x:Key="TarjetaTabla" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="{StaticResource Radio}" Background="White" Effect="{StaticResource SombraSuave}"/>
                        <Border x:Name="marco" CornerRadius="{StaticResource Radio}" Background="White"
                                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1" Padding="1">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cabecera de tabla (fila de títulos de columna). -->
    <Style x:Key="CabeceraTabla" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineaSuaveBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
        <Setter Property="Padding" Value="18,9"/>
    </Style>

    <!-- Lista con estado vacío y de carga (en vez de una pantalla en blanco).
         Tag = sugerencia que acompaña al mensaje de «no hay registros». -->
    <Style x:Key="Lista" TargetType="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Grid>
                        <ItemsPresenter/>
                        <StackPanel x:Name="vacio" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Top" Margin="24,40,24,32">
                            <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource LavandaBrush}"
                                    HorizontalAlignment="Center">
                                <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoVacio}"
                                                Foreground="{StaticResource MoradoTextoBrush}" Width="22" Height="22"/>
                            </Border>
                            <TextBlock Text="No hay registros para mostrar" FontSize="15" FontWeight="ExtraBold"
                                       Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="12.5" Foreground="{StaticResource ApagadoBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="cargando" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Top" Margin="24,44,24,32">
                            <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoEstrella}"
                                            Foreground="{StaticResource AmarilloOscuroBrush}" Width="30" Height="30"
                                            RenderTransformOrigin="0.5,0.5">
                                <ContentControl.RenderTransform>
                                    <ScaleTransform/>
                                </ContentControl.RenderTransform>
                                <!-- Estrella que late suave, como .loading-star de la web. -->
                                <ContentControl.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="0.85" To="1.15" Duration="0:0:0.65"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.85" To="1.15" Duration="0:0:0.65"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ContentControl.Triggers>
                            </ContentControl>
                            <TextBlock Text="Cargando datos…" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource ApagadoBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding Path=(local:EstadoUi.Ocupado)}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="vacio" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding Path=(local:EstadoUi.Ocupado)}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="cargando" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botones (.btn de la web) ===== -->
    <!-- Contorno de foco (solo al navegar con teclado): amarillo como en la web. -->
    <Style x:Key="FocoRedondeado">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="17" Margin="-4" BorderThickness="2.5"
                            BorderBrush="{StaticResource AmarilloBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base de los botones grandes. Tag = color del borde inferior (efecto de la web). -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Tag" Value="{x:Null}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="raiz" RenderTransformOrigin="0.5,0.5">
                        <!-- Borde inferior más oscuro, como .btn { box-shadow: 0 3px 0 ... } -->
                        <Border x:Name="base" CornerRadius="14" Background="{TemplateBinding Tag}" Margin="0,3,0,0"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}" Margin="0,0,0,3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="bd" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="raiz" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="raiz" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="base" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="raiz" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amarillo: acción principal (Crear, Guardar, Ingresar…) = .btn.yellow -->
    <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AmarilloBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AmarilloTextoBrush}"/>
        <Setter Property="Tag" Value="{StaticResource AmarilloOscuroBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmarilloHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Blanco con borde: Cancelar y acciones secundarias = .btn.ghost -->
    <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource MoradoTextoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MoradoBordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MoradoSuaveBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Coral: confirmar acciones destructivas (eliminar, dar de baja). -->
    <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource CoralTextoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Tag" Value="{StaticResource CoralOscuroBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CoralHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Verde: confirmar acciones de éxito (reactivar). -->
    <Style x:Key="BtnExito" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource VerdeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Tag" Value="{StaticResource VerdeOscuroBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource VerdeOscuroBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón de las filas (Editar, Dar de baja, Eliminar…) = .btn.small / .icon-button.
         Foreground = color del texto, BorderBrush = borde, Tag = fondo al pasar el mouse.
         Ui.Accion los arma con el tono de cada acción. -->
    <Style x:Key="BtnAccion" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TealBordeBrush}"/>
        <Setter Property="Tag" Value="{StaticResource MentaBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de icono cuadrado (paginación, ojo de la contraseña…) = .icon-button -->
    <Style x:Key="BtnIcono" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Menta2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cerrar sesión: tono coral suave (.danger-btn de la web). -->
    <Style x:Key="BtnSalir" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource CoralTextoBrush}"/>
        <Setter Property="Background" Value="{StaticResource CoralSuaveBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CoralBordeBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE3E9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acceso rápido del Inicio (.summary-card de la web): Tag = icono, Content = textos,
         Background = fondo del icono y BorderBrush = color del icono. Textos en navy. -->
    <Style x:Key="Acceso" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="Background" Value="{StaticResource MentaBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="raiz" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="sombra" CornerRadius="22" Background="White" Effect="{StaticResource SombraLeve}"/>
                        <Border x:Name="bd" CornerRadius="22" Background="White" BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="1" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="15" Background="{TemplateBinding Background}"
                                        VerticalAlignment="Top">
                                    <ContentControl Style="{StaticResource Icono}" Tag="{TemplateBinding Tag}" Width="22" Height="22"
                                                    Foreground="{TemplateBinding BorderBrush}"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="14,2,8,0" VerticalAlignment="Top"/>
                                <ContentControl x:Name="flecha" Grid.Column="2" Style="{StaticResource Icono}"
                                                Tag="{StaticResource IcoFlecha}" Width="18" Height="18"
                                                Foreground="{StaticResource ApagadoBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="raiz" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBordeBrush}"/>
                            <Setter TargetName="flecha" Property="Foreground" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="sombra" Property="Effect" Value="{StaticResource SombraSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones de la ventana (minimizar / maximizar / cerrar). -->
    <Style x:Key="BtnVentana" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeutroSuaveBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón redondo para cerrar la ventana. -->
    <Style x:Key="BtnCerrar" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondeado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CoralSuaveBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CoralBordeBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CoralTextoBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menú lateral: RadioButton = sección (Tag = icono). =====
         La letra se define en el propio RadioButton (no en el ContentPresenter) para que
         un encabezado con contenido propio (p. ej. Asignaciones + aviso) herede igual. -->
    <Style x:Key="ItemMenu" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Navy2Brush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="14" Padding="12,10" MinHeight="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="ico" Style="{StaticResource Icono}" Tag="{TemplateBinding Tag}"
                                            Foreground="{StaticResource ApagadoBrush}" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="texto" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F1FBFB"/>
                            <Setter Property="Foreground" Value="#08757A"/>
                            <Setter TargetName="ico" Property="Foreground" Value="#08757A"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource MentaBrush}"/>
                            <Setter Property="Foreground" Value="#08757A"/>
                            <Setter Property="FontWeight" Value="ExtraBold"/>
                            <Setter TargetName="ico" Property="Foreground" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AmarilloBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <!-- Menú compacto (ventana angosta): solo iconos, centrados. -->
                        <DataTrigger Binding="{Binding Compacto, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="texto" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="bd" Property="Padding" Value="0,10"/>
                            <Setter TargetName="ico" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="ico" Property="Grid.ColumnSpan" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Campos de texto (estilo por defecto) =====
         Tag = texto de ayuda (placeholder) que se ve cuando el campo está vacío. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Anillo de foco suave (menta), como el :focus de la web. -->
                        <Border x:Name="anillo" CornerRadius="17" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource MentaBrush}" Visibility="Collapsed"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadioControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource ApagadoBrush}" Opacity="0.75" FontWeight="Normal"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buscador: lupa a la izquierda (.input-shell de la web). -->
    <Style x:Key="CampoBusqueda" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="40,0,12,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="anillo" CornerRadius="17" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource MentaBrush}" Visibility="Collapsed"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadioControl}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource ApagadoBrush}" Opacity="0.75" FontWeight="Normal"
                                           VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ContentControl Style="{StaticResource Icono}" Tag="{StaticResource IcoBuscar}" Width="18" Height="18"
                                        Foreground="#2D4B86" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de varias líneas (enunciados, descripciones). -->
    <Style x:Key="CampoMultilinea" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TealOscuroBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="anillo" CornerRadius="17" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource MentaBrush}" Visibility="Collapsed"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadioControl}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox y RadioButton ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="caja" Width="22" Height="22" CornerRadius="7" Background="White"
                                BorderBrush="{StaticResource BordeBrush}" BorderThickness="2"
                                VerticalAlignment="Center">
                            <Path x:Name="check" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caja" Property="Background" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse x:Name="aro" Fill="White" Stroke="{StaticResource BordeBrush}" StrokeThickness="2"/>
                            <Ellipse x:Name="punto" Width="10" Height="10" Fill="{StaticResource TealBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="aro" Property="Stroke" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="aro" Property="Stroke" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="aro" Property="Fill" Value="{StaticResource MentaBrush}"/>
                            <Setter TargetName="punto" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MaxDropDownHeight" Value="300"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="anillo" CornerRadius="17" Margin="-3" BorderThickness="3"
                                BorderBrush="{StaticResource MentaBrush}" Visibility="Collapsed"/>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="White" CornerRadius="{StaticResource RadioControl}"
                                            BorderBrush="{StaticResource BordeBrush}" BorderThickness="1.5"
                                            Padding="12,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            <ContentControl x:Name="flecha" Grid.Column="1" Style="{StaticResource Icono}"
                                                            Tag="{StaticResource IcoDerecha}" Width="16" Height="16"
                                                            Foreground="{StaticResource TealOscuroBrush}" Margin="8,0,2,0"
                                                            RenderTransformOrigin="0.5,0.5">
                                                <ContentControl.RenderTransform>
                                                    <RotateTransform Angle="90"/>
                                                </ContentControl.RenderTransform>
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealMedioBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="White" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadioControl}" Padding="5" Margin="0,6,10,14"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                    Effect="{StaticResource SombraLeve}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="anillo" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="cont" Background="Transparent" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="cont" Property="Background" Value="{StaticResource MentaBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="cont" Property="Background" Value="{StaticResource Menta2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pestañas: control segmentado dentro de una barra blanca ===== -->
    <Style x:Key="Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="4"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La letra del encabezado se define en el ContentPresenter (y no en el TabItem)
         para que el contenido de la pestaña no herede ni el color ni la negrita. -->
    <Style x:Key="Tab" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tab" CornerRadius="12" Background="Transparent" Padding="16,8" Margin="1,0">
                        <ContentPresenter x:Name="hdr" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource ApagadoBrush}"
                                          TextElement.FontWeight="ExtraBold" TextElement.FontSize="13.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource Menta2Brush}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource TealBrush}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="tab" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secciones sin barra de pestañas: la navegación la hace el menú lateral. -->
    <Style x:Key="TabsSinCabecera" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Height="0" Visibility="Hidden" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sub-pestañas (dentro de una sección): segmentado más pequeño ===== -->
    <Style x:Key="TabsSub" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource NeutroSuaveBrush}" CornerRadius="14" Padding="4"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabSub" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tab" CornerRadius="11" Background="Transparent" Padding="14,7" Margin="0,0,2,0">
                        <ContentPresenter x:Name="hdr" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource ApagadoBrush}"
                                          TextElement.FontWeight="ExtraBold" TextElement.FontSize="13"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{StaticResource NavyBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="White"/>
                            <Setter TargetName="tab" Property="Effect" Value="{StaticResource SombraLeve}"/>
                            <Setter TargetName="hdr" Property="TextElement.Foreground" Value="{StaticResource TealOscuroBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barras de desplazamiento finas y redondeadas ===== -->
    <Style x:Key="ScrollPagina" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="{StaticResource BordeBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource TealMedioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource TealBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2,4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="4,2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPagina}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ToolTip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

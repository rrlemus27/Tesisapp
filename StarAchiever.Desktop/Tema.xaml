<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:local="clr-namespace:StarAchiever.Desktop"
                    mc:Ignorable="po">

    <!-- =====================================================================
         TEMA STAR-ACHIEVER · PANEL ADMIN
         Misma identidad que la web docente (wwwroot/css/theme.css): paleta,
         radios de 24/30 px, sombra 0 14px 35px rgba(31,68,107,.08), Nunito
         e iconos de trazo de 24x24. Versión sobria para administración.
         ===================================================================== -->

    <!-- ===== Paleta oficial (theme.css :root) ===== -->
    <SolidColorBrush x:Key="FondoBrush" Color="#F8FCFF" po:Freeze="True"/>        <!-- background -->
    <SolidColorBrush x:Key="SuperficieBrush" Color="#FFFFFF" po:Freeze="True"/>    <!-- surface -->
    <SolidColorBrush x:Key="NavyBrush" Color="#0B1B57" po:Freeze="True"/>          <!-- navy / ink -->
    <SolidColorBrush x:Key="Navy2Brush" Color="#14235F" po:Freeze="True"/>         <!-- navy-2 -->
    <SolidColorBrush x:Key="TealBrush" Color="#08AAA8" po:Freeze="True"/>          <!-- teal -->
    <SolidColorBrush x:Key="TealOscuroBrush" Color="#087D80" po:Freeze="True"/>    <!-- teal-dark -->
    <SolidColorBrush x:Key="AmarilloBrush" Color="#FFD10A" po:Freeze="True"/>      <!-- yellow -->
    <SolidColorBrush x:Key="AmarilloOscuroBrush" Color="#D9AD00" po:Freeze="True"/><!-- yellow-dark -->
    <SolidColorBrush x:Key="AmarilloTextoBrush" Color="#0A174D" po:Freeze="True"/> <!-- texto sobre amarillo -->
    <SolidColorBrush x:Key="MoradoBrush" Color="#7442D7" po:Freeze="True"/>        <!-- purple -->
    <SolidColorBrush x:Key="CoralBrush" Color="#FF6F85" po:Freeze="True"/>         <!-- coral -->
    <SolidColorBrush x:Key="VerdeBrush" Color="#12A675" po:Freeze="True"/>         <!-- green -->
    <SolidColorBrush x:Key="MentaBrush" Color="#DFF8F5" po:Freeze="True"/>         <!-- mint -->
    <SolidColorBrush x:Key="Menta2Brush" Color="#EEFCFB" po:Freeze="True"/>        <!-- mint-2 -->
    <SolidColorBrush x:Key="LavandaBrush" Color="#EFE5FF" po:Freeze="True"/>       <!-- lavender -->
    <SolidColorBrush x:Key="CremaBrush" Color="#FFF6D9" po:Freeze="True"/>         <!-- cream -->
    <SolidColorBrush x:Key="ApagadoBrush" Color="#64729A" po:Freeze="True"/>       <!-- muted -->
    <SolidColorBrush x:Key="BordeBrush" Color="#D9E9F2" po:Freeze="True"/>         <!-- line -->

    <!-- Derivados que ya usa la web para texto legible sobre fondos claros. -->
    <SolidColorBrush x:Key="LineaSuaveBrush" Color="#E8EEF3" po:Freeze="True"/>    <!-- separador de filas -->
    <SolidColorBrush x:Key="FilaHoverBrush" Color="#F6FBFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="CoralTextoBrush" Color="#E63F5D" po:Freeze="True"/>    <!-- .danger-btn -->
    <SolidColorBrush x:Key="CoralOscuroBrush" Color="#D93552" po:Freeze="True"/>
    <SolidColorBrush x:Key="VerdeTextoBrush" Color="#0E8A60" po:Freeze="True"/>
    <SolidColorBrush x:Key="VerdeOscuroBrush" Color="#0E8F64" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmarilloTextoSuaveBrush" Color="#7A5B00" po:Freeze="True"/>
    <SolidColorBrush x:Key="MoradoTextoBrush" Color="#6140B3" po:Freeze="True"/>   <!-- .btn.ghost -->
    <SolidColorBrush x:Key="MoradoBordeBrush" Color="#DFD3F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="TealBordeBrush" Color="#BFE8E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="CoralBordeBrush" Color="#FFC7D2" po:Freeze="True"/>
    <SolidColorBrush x:Key="VerdeBordeBrush" Color="#BDE9D0" po:Freeze="True"/>

    <!-- Versiones suaves (fondos de chips, botones e iconos). -->
    <SolidColorBrush x:Key="MoradoSuaveBrush" Color="#F4EEFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CoralSuaveBrush" Color="#FFF0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="VerdeSuaveBrush" Color="#E8FBF1" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmarilloSuaveBrush" Color="#FFF6D9" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutroSuaveBrush" Color="#F1F6FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="TealMedioBrush" Color="#8008AAA8" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlancoTranslucidoBrush" Color="#1FFFFFFF" po:Freeze="True"/>

    <!-- Notificaciones (.notice / .notice.green / .notice.blue de la web). -->
    <SolidColorBrush x:Key="ExitoFondoBrush" Color="#E8FBF1" po:Freeze="True"/>
    <SolidColorBrush x:Key="ExitoBordeBrush" Color="#BDE9D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="ExitoTextoBrush" Color="#176849" po:Freeze="True"/>
    <SolidColorBrush x:Key="AvisoFondoBrush" Color="#FFF4DC" po:Freeze="True"/>
    <SolidColorBrush x:Key="AvisoBordeBrush" Color="#F2D99A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AvisoTextoBrush" Color="#75530C" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorFondoBrush" Color="#FFF0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorBordeBrush" Color="#FFC7D2" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorTextoBrush" Color="#B4233F" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoFondoBrush" Color="#EBF9FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBordeBrush" Color="#C8EAF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoTextoBrush" Color="#285C77" po:Freeze="True"/>

    <!-- Estados hover / pressed de los botones grandes. -->
    <SolidColorBrush x:Key="AmarilloHoverBrush" Color="#F7C900" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmarilloPressedBrush" Color="#EDBC00" po:Freeze="True"/>
    <SolidColorBrush x:Key="CoralHoverBrush" Color="#D93552" po:Freeze="True"/>

    <!-- Fondo del panel de marca del login: navy sobrio con un brillo teal. -->
    <LinearGradientBrush x:Key="FondoMarcaBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#0B1B57" Offset="0"/>
        <GradientStop Color="#14235F" Offset="0.55"/>
        <GradientStop Color="#0B4F6C" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Logo (Assets/logo.png, el mismo de la web docente). Un solo lugar para cambiarlo. ===== -->
    <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/StarAchiever.Desktop;component/Assets/logo.png"
                 po:Freeze="True"/>

    <!-- ===== Tipografía: Nunito embebida (Fonts/), con los mismos respaldos que la web ===== -->
    <FontFamily x:Key="FuenteApp">./Fonts/#Nunito, Poppins, Segoe UI</FontFamily>

    <!-- ===== Radios (radius 24px / radius-lg 30px) ===== -->
    <CornerRadius x:Key="Radio">24</CornerRadius>
    <CornerRadius x:Key="RadioGrande">30</CornerRadius>
    <CornerRadius x:Key="RadioControl">14</CornerRadius>

    <!-- ===== Sombras: shadow 0 14px 35px rgba(31,68,107,.08) ===== -->
    <DropShadowEffect x:Key="SombraSuave" Color="#1F446B" Direction="270" ShadowDepth="14"
                      BlurRadius="35" Opacity="0.08" po:Freeze="True"/>
    <DropShadowEffect x:Key="SombraLeve" Color="#1F446B" Direction="270" ShadowDepth="8"
                      BlurRadius="24" Opacity="0.06" po:Freeze="True"/>
    <DropShadowEffect x:Key="SombraVentana" Color="#1F446B" Direction="270" ShadowDepth="10"
                      BlurRadius="34" Opacity="0.20" po:Freeze="True"/>

